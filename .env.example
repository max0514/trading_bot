# twlab configuration — copy to .env and edit. Every setting is an environment
# variable; docker compose reads this file, and the code reads the same names.

# ── server (docker compose) ────────────────────────────────────────────────
TZ=Asia/Taipei
TWLAB_MONGO_DB=twlab
# The three settings below are overrides: comment one out and the built-in
# default applies (schedules from docker/entrypoint.sh, catch-up from
# twlab/orchestrator.py). The values shown are those defaults.
#
# Nightly Orchestrator run (cron syntax, container time zone). 22:30 is after
# every daily source has published (TWSE/TPEx by 21:32, MOPS revenue by 22:00).
TWLAB_CRON_RUN=30 22 * * *
# Weekly FinMind Witness cross-check (alert only).
TWLAB_CRON_WITNESS=30 23 * * 0
# Due days caught up per Dataset per run; older gaps are an explicit backfill.
TWLAB_MAX_CATCHUP=14
# Optional FinMind token for the Witness (free tier works without one).
FINMIND_TOKEN=
# Host ports.
MONGO_BIND=127.0.0.1
MONGO_PORT=27017
TWLAB_STORE_PORT=8787
DASHBOARD_PORT=8050

# ── host-side tools (dashboard / notebooks on the same machine) ────────────
MONGODB_URI=mongodb://127.0.0.1:27017
# Where the pipeline materializes Parquet Wide Frames (default ~/.twlab/store).
# TWLAB_STORE_DIR=/srv/twlab/store

# ── research machines ──────────────────────────────────────────────────────
# Point data.get() at the server's store; frames sync through a local cache
# (TWLAB_STORE_DIR) and keep working offline.
# TWLAB_SERVER_URL=http://nas.local:8787
# ...or a LAN mount of the store directory instead of HTTP:
# TWLAB_REMOTE_STORE=/Volumes/twlab/store
# Seconds between freshness checks (default 3600).
# TWLAB_CACHE_TTL=3600
